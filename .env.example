# ==============================================================================
# FinAI Environment Configuration Template
# Copy this file to .env or set these environment variables in your system.
# Never commit actual secret keys to source control.
# ==============================================================================

# Server Port (Default: 8080)
PORT=8080

# Google Gemini API Key
# Obtain a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Active AI Provider: gemini | fallback
AI_PROVIDER=gemini
